# Copy outside the checkout with mode 0600. Set two different, persistent random
# values for the secrets before starting the app.
OVERLEAF_APP_NAME="Overleaf CE+"
OVERLEAF_SITE_URL=http://127.0.0.1:8080
OVERLEAF_ADMIN_EMAIL=
OVERLEAF_SESSION_SECRET=
OVERLEAF_INVITE_TOKEN_SECRET=
NGINX_WORKER_PROCESSES=2
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
EMAIL_CONFIRMATION_DISABLED=true
EXTERNAL_AUTH=none
# For HTTPS set the public URL above and apply deploy/compose.https.yaml.
# For trusted proxy IP handling, set OVERLEAF_TRUSTED_PROXY_IPS to match the
# actual proxy chain. The default trusts only loopback.
